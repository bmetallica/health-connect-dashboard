# MariaDB-Zugangsdaten (die Datenbank ist nur im Docker-Netz erreichbar)
DB_NAME=health
DB_USER=health
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern

# Optional: Zugangstoken für den Ingest-Port (empfohlen, wenn er im Internet erreichbar ist).
# Sender schicken es als Header "X-Ingest-Token: <token>" (oder "Authorization: Bearer <token>").
# Leer = keine Prüfung.
INGEST_TOKEN=
